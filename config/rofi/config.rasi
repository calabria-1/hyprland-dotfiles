@import "colors.rasi"

configuration {
    modi: ["drun"]; // Verwendbar Modi(drun = App Launcher)
    show-icons: true; // Zeigt Icons der Einträge, wenn vorhanden
    display-drun: "Apps ➜"; // Prompt vor dem Suchfeld
    drun-display-format: "{name}";
    hover-select: false; // Erlaubt dem Mauszeiger Einträge auszuwählen 
    font: "JetBrainsMono Nerd Font 11"; // Schriftart
}

window {
    width: 600px; // Breite
    height: 330px; // Höhe

    // Umrandung
    border-color: @outline-variant;
    border: 2px;
    border-radius: 10px;
    
    background-color: @surface; // Farbe des Fensters, bzw. des äußeren Teils
    
    padding: 15px 15px 5px 15px; // Abstand zwischen Rahmen und Einträgen
}

mainbox {
    spacing: 15px 15px 5px 15px; // setzt Abstand zwischen Suchleiste und Einträgen
}

inputbar {
    // Suchleiste
    background-color: @surface-container; // Farbe
    
    // Umrandung der Suchleiste
    border-color: @outline-variant;
    border-radius: 10px;
    border: 1px;

    // Position von Text ("Anwendung suchen...")
    padding: 8px;
    spacing: 8px;

    // Hiermit werden prompt und entry inputbar untergeordnet
    children: [ prompt, entry ];
}

prompt {
    // definiert den Prompt ("Apps ➜")
    background-color: transparent;
    text-color: @secondary;
}

entry {
    // definiert Eingabefeld
    background-color: transparent;
    text-color: @secondary;
    placeholder: "Anwendung suchen..."; // Platzhalter im Eingabefeld
    placeholder-color: @secondary; // Farbe des Platzhalter
}

listview {
    // Block der gefundenen Treffer
    background-color: @surface; // Hintergrund
    columns: 1; // Anzahl der Spalten; normal 1
    border: 0px; // optionale Umrandung
    cycle: true; // Erlaubt das springen vom letzen zum ersten Eintrag und umgekehrt
    spacing: 0px; // Entfernung zwischen den einzelnen Einträgen
    scrollbar: false; // deaktiviert die Scrollbar am rechten Rand 
}

element {
    // gibt Rundung und Größe der Felder an
    border-radius: 10px;
    padding: 8px;
}

element normal.normal {
    // legt Farbe des Feldes und Text fest(Feld:2,4,6,..)
    background-color: @surface;
    text-color: @on-surface;
}

element alternate.normal {
    // legt Farbe des Feldes und Text fest(Feld:1,3,5,..)
    background-color: @surface;
    text-color: @on-surface;
}

element selected.normal {
    // legt Farbe des ausgewählten Feldes und Text fest
    background-color: @primary-container;
    text-color: @on-primary-container;
}


element-icon {
    // bestimmt Größe des Icon
    size: 24px;
}

element-text {
    // setzt Text mittig ins Feld
    vertical-align: 0.5;
}
